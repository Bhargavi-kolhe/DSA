import java.util.*;
class Solution {
    int i = 0;
    public List<String> braceExpansionII(String expression) {
        Set<String> set = parseUnion(expression);
        List<String> ans = new ArrayList<>(set);
        Collections.sort(ans);
        return ans;
    }
    Set<String> parseUnion(String s) {
        Set<String> result = new HashSet<>();
        while (i < s.length() && s.charAt(i) != '}') {
            Set<String> cur = parseConcat(s);
            result.addAll(cur);
            if (i < s.length() && s.charAt(i) == ',') {
                i++;
            } else {
                break;
            }
        }
        return result;
    }
    Set<String> parseConcat(String s) {
        Set<String> result = new HashSet<>();
        result.add("");
        while (i < s.length()
                && s.charAt(i) != '}'
                && s.charAt(i) != ',') {
            Set<String> cur;
            if (s.charAt(i) == '{') {
                i++; 
                cur = parseUnion(s);
                i++; 
            } else {
                cur = new HashSet<>();
                cur.add(String.valueOf(s.charAt(i)));
                i++;
            }
            result = multiply(result, cur);
        }
        return result;
    }
    Set<String> multiply(Set<String> a, Set<String> b) {
        Set<String> result = new HashSet<>();

        for (String x : a) {
            for (String y : b) {
                result.add(x + y);
            }
        }

        return result;
    }
}
