class Solution {

    static class Node {
        int leftChar;
        int rightChar;
        int prefix;
        int suffix;
        int max;
        int len;

        Node(int c) {
            leftChar = rightChar = c;
            prefix = suffix = max = len = 1;
        }

        Node() {
        }
    }

    Node[] tree;
    char[] s;

    public int[] longestRepeating(String str,
                                  String queryCharacters,
                                  int[] queryIndices) {

        int n = str.length();
        int k = queryIndices.length;

        s = str.toCharArray();
        tree = new Node[4 * n];

        build(1, 0, n - 1);

        int[] ans = new int[k];

        for (int i = 0; i < k; i++) {

            int index = queryIndices[i];
            char ch = queryCharacters.charAt(i);

            s[index] = ch;

            update(1, 0, n - 1, index, ch - 'a');

            ans[i] = tree[1].max;
        }

        return ans;
    }

    
    void build(int node, int l, int r) {

        if (l == r) {
            tree[node] = new Node(s[l] - 'a');
            return;
        }

        int mid = (l + r) / 2;

        build(node * 2, l, mid);
        build(node * 2 + 1, mid + 1, r);

        tree[node] = merge(tree[node * 2], tree[node * 2 + 1]);
    }

    
    void update(int node, int l, int r, int index, int ch) {

        if (l == r) {
            tree[node] = new Node(ch);
            return;
        }

        int mid = (l + r) / 2;

        if (index <= mid) {
            update(node * 2, l, mid, index, ch);
        } else {
            update(node * 2 + 1, mid + 1, r, index, ch);
        }

        tree[node] = merge(tree[node * 2], tree[node * 2 + 1]);
    }

    
    Node merge(Node a, Node b) {

        Node res = new Node();

        res.len = a.len + b.len;

        res.leftChar = a.leftChar;
        res.rightChar = b.rightChar;

         
        res.prefix = a.prefix;

        if (a.prefix == a.len && a.rightChar == b.leftChar) {
            res.prefix = a.len + b.prefix;
        }

    
        res.suffix = b.suffix;

        if (b.suffix == b.len && a.rightChar == b.leftChar) {
            res.suffix = b.len + a.suffix;
        }

       
        res.max = Math.max(a.max, b.max);

        if (a.rightChar == b.leftChar) {
            res.max = Math.max(res.max,
                    a.suffix + b.prefix);
        }

        return res;
    }
}
