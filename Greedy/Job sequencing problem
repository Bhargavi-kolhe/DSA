class Solution {
    public int[] JobScheduling(int[][] Jobs) {
        int n = Jobs.length;

        Arrays.sort(Jobs, (a,b) -> b[2] - a[2]);
        int maxDeadline = 0;
        for (int i=0 ;i<n; i++) {
            maxDeadline = Math.max(maxDeadline,Jobs[i][1]);
        }
        int[] slot = new int[maxDeadline + 1];
        
            Arrays.fill(slot,-1);
        

        int count = 0;
        int totalProfit = 0;

        for (int i = 0; i < n; i++){
                int jobId = Jobs[i][0];
                int deadline = Jobs[i][1];
                int profit = Jobs[i][2];

                for(int j=deadline; j>=1; j--){
                    if (slot[j] == -1){
                        slot[j] = jobId;

                        count++;
                        totalProfit += profit;

                        break;

                    }
                }
            }
            return new int[]{count, totalProfit};


        }
}



    
