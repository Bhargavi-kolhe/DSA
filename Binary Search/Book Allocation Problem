class Solution {
    static boolean isValidAnswer(int[] nums, int m, int maxPages){
        int studentCount = 1;
        int pages = 0;

        for(int i=0;i<nums.length;i++){
            if(pages+nums[i]<= maxPages){
                pages = pages + nums[i];

            }else{
                studentCount++;
                if(studentCount > m || nums[i] > maxPages){
                    return false;
                }
                
                pages = nums[i];
                }
            }
            return true;
        }

    
    
    public int findPages(int[] nums, int m) {
        int n = nums.length;

        if (m > n) {
            return -1;
        }

        int s = 1;
        int sum = 0;
        for(int i=0;i<n;i++){
            sum +=nums[i];
        }

        int e = sum;
        int ans = -1;
        while (s <= e){
            int mid = s +(e-s)/2;
        

        if(isValidAnswer(nums, m, mid)){
            ans = mid;
            e = mid - 1;

        }
        else{
            s = mid + 1;

        }
        }
        return ans;
   
    }
}
